# --- Required ---
# Supabase: Project settings > Database > Connection string (URI). Use the pooler URI on Render.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:6543/postgres
# Long random string, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,https://techcareerfit-1.onrender.com

# --- Optional ---
JWT_EXPIRE_MINUTES=60
# Emails that become administrators when they register
ADMIN_EMAILS=
# Kaggle AI Jobs Market 2025-2026 CSV (included in data/)
MARKET_CSV_PATH=data/ai_jobs_market_2025_2026.csv
# Email reminders (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TechCareerFit <no-reply@techcareerfit.app>
FRONTEND_URL=https://techcareerfit-1.onrender.com
